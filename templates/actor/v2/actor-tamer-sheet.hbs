{{!-- 
    Digidices System - Tamer Character Sheet
    Template for Tamer actors in Foundry VTT
--}}
<div class="digidices-tamer custom-system-entity">
    {{!-- Sheet Header --}}
    <header class="tamer-header">
        <div class="tamer-portrait" data-action="editImage" data-field="img">
            <img class="profile-img" src="{{document.img}}" title="{{document.name}}" />
        </div>
        
        <div class="tamer-info">
            <div class="tamer-name-row">
                <input type="text" name="name" value="{{document.name}}" placeholder="Nome do Tamer" class="tamer-name-input" />
            </div>
            
            <div class="tamer-stats-row">
                <div class="stat-box">
                    <label>Nivel</label>
                    <input type="number" name="system.nivel" value="{{system.nivel}}" min="1" />
                </div>
                <div class="stat-box">
                    <label>Idade</label>
                    <input type="number" name="system.idade" value="{{system.idade}}" min="0" />
                </div>
                <div class="stat-box">
                    <label>Popularidade</label>
                    <input type="number" name="system.popularidade" value="{{system.popularidade}}" />
                </div>
                <div class="stat-box">
                    <label>Estudo</label>
                    <input type="number" name="system.estudo" value="{{system.estudo}}" />
                </div>
            </div>
            
            <div class="tamer-brasao-row">
                <label>Brasao</label>
                <input type="text" name="system.brasao" value="{{system.brasao}}" placeholder="Brasao do Tamer" />
            </div>
        </div>
    </header>

    {{!-- Tab Navigation --}}
    <nav class="tamer-tabs">
        <a class="tab-item {{#if (eq activeTab 'pessoal')}}active{{/if}}" data-action="switchTab" data-tab="pessoal">
            <i class="fas fa-user"></i> Pessoal
        </a>
        <a class="tab-item {{#if (eq activeTab 'atributos')}}active{{/if}}" data-action="switchTab" data-tab="atributos">
            <i class="fas fa-fist-raised"></i> Atributos
        </a>
        <a class="tab-item {{#if (eq activeTab 'recursos')}}active{{/if}}" data-action="switchTab" data-tab="recursos">
            <i class="fas fa-star"></i> Recursos
        </a>
        <a class="tab-item {{#if (eq activeTab 'inventario')}}active{{/if}}" data-action="switchTab" data-tab="inventario">
            <i class="fas fa-briefcase"></i> Inventario
        </a>
    </nav>

    {{!-- Tab Content --}}
    <div class="tamer-content">
        {{!-- Tab: Pessoal --}}
        <section class="tab-content {{#if (eq activeTab 'pessoal')}}active{{/if}}" data-tab="pessoal">
            <div class="personal-section">
                <h3 class="section-title">
                    <i class="fas fa-id-card"></i> Informacoes Pessoais
                </h3>
                
                <div class="personal-grid">
                    <div class="personal-field full-width">
                        <label>Nome Completo</label>
                        <input type="text" name="system.nome" value="{{system.nome}}" placeholder="Nome completo do personagem" />
                    </div>
                </div>
                
                <h3 class="section-title">
                    <i class="fas fa-mobile-alt"></i> Digivice
                </h3>
                
                <div class="digivice-section">
                    <div class="digivice-field">
                        <label>Tipo</label>
                        <input type="text" name="system.digivice.tipo" value="{{system.digivice.tipo}}" placeholder="Ex: D-3, D-Arc, etc." />
                    </div>
                    <div class="digivice-field">
                        <label>Cor</label>
                        <input type="text" name="system.digivice.cor" value="{{system.digivice.cor}}" placeholder="Cor do Digivice" />
                    </div>
                    <div class="digivice-field full-width">
                        <label>Descricao</label>
                        <textarea name="system.digivice.descricao" placeholder="Descricao especial do Digivice">{{system.digivice.descricao}}</textarea>
                    </div>
                </div>
            </div>
        </section>

        {{!-- Tab: Atributos e Pericias --}}
        <section class="tab-content {{#if (eq activeTab 'atributos')}}active{{/if}}" data-tab="atributos">
            {{!-- Roll Test Button --}}
            <div class="roll-test-section">
                <button type="button" class="roll-test-btn" data-action="rolarTeste">
                    <i class="fas fa-dice"></i> Rolar Teste
                </button>
            </div>

            {{!-- Combat Stats --}}
            <div class="combat-stats">
                <div class="combat-stat pv-stat">
                    <div class="stat-header">
                        <span class="stat-label">PV</span>
                        <button type="button" class="config-btn" data-action="editarFormula" data-field="pv" title="Editar Formula">
                            <i class="fas fa-cog"></i>
                        </button>
                    </div>
                    <div class="stat-bar">
                        <div class="bar-fill pv-fill" style="width: {{pvPercent}}%"></div>
                    </div>
                    <div class="stat-values">
                        <input type="number" name="system.pv.valor" value="{{system.pv.valor}}" min="0" />
                        <span>/</span>
                        <input type="number" name="system.pv.maximo" value="{{system.pv.maximo}}" min="1" />
                    </div>
                </div>

                <div class="combat-stat aura-stat">
                    <div class="stat-header">
                        <span class="stat-label">Digi-Aura</span>
                        <button type="button" class="config-btn" data-action="editarFormula" data-field="digiAura" title="Editar Formula">
                            <i class="fas fa-cog"></i>
                        </button>
                    </div>
                    <div class="stat-bar">
                        <div class="bar-fill aura-fill" style="width: {{auraPercent}}%"></div>
                    </div>
                    <div class="stat-values">
                        <input type="number" name="system.digiAura.valor" value="{{system.digiAura.valor}}" min="0" />
                        <span>/</span>
                        <input type="number" name="system.digiAura.maximo" value="{{system.digiAura.maximo}}" min="1" />
                    </div>
                </div>

                <div class="combat-stat defesa-stat">
                    <div class="stat-header">
                        <span class="stat-label">Defesa</span>
                        <button type="button" class="config-btn" data-action="editarFormula" data-field="defesa" title="Editar Formula">
                            <i class="fas fa-cog"></i>
                        </button>
                    </div>
                    <div class="stat-value-single">
                        <input type="number" name="system.defesa.valor" value="{{system.defesa.valor}}" />
                    </div>
                </div>
            </div>

            {{!-- Attributes --}}
            <h3 class="section-title">
                <i class="fas fa-chart-bar"></i> Atributos
            </h3>
            
            <div class="attributes-grid">
                {{#each atributosArray}}
                <div class="attribute-card">
                    <div class="attribute-abbr">{{this.abbr}}</div>
                    <div class="attribute-name">{{this.label}}</div>
                    <input type="number" name="system.atributos.{{this.key}}" value="{{this.value}}" min="1" />
                </div>
                {{/each}}
            </div>

            {{!-- Skills --}}
            <h3 class="section-title">
                <i class="fas fa-running"></i> Pericias
            </h3>
            
            <div class="skills-container">
                {{!-- Physical Skills --}}
                <div class="skill-category">
                    <h4 class="category-title">Fisicas</h4>
                    <div class="skills-list">
                        {{#each periciasFisicas}}
                        <div class="skill-row">
                            <span class="skill-name">{{this.label}}</span>
                            <input type="number" name="system.pericias.{{this.key}}" value="{{this.value}}" min="0" />
                        </div>
                        {{/each}}
                    </div>
                </div>

                {{!-- Mental Skills --}}
                <div class="skill-category">
                    <h4 class="category-title">Mentais</h4>
                    <div class="skills-list">
                        {{#each periciasMentais}}
                        <div class="skill-row">
                            <span class="skill-name">{{this.label}}</span>
                            <input type="number" name="system.pericias.{{this.key}}" value="{{this.value}}" min="0" />
                        </div>
                        {{/each}}
                    </div>
                </div>

                {{!-- Social Skills --}}
                <div class="skill-category">
                    <h4 class="category-title">Sociais</h4>
                    <div class="skills-list">
                        {{#each periciasSociais}}
                        <div class="skill-row">
                            <span class="skill-name">{{this.label}}</span>
                            <input type="number" name="system.pericias.{{this.key}}" value="{{this.value}}" min="0" />
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        </section>

        {{!-- Tab: Recursos --}}
        <section class="tab-content {{#if (eq activeTab 'recursos')}}active{{/if}}" data-tab="recursos">
            <div class="resources-header">
                <h3 class="section-title">
                    <i class="fas fa-star"></i> Recursos
                </h3>
                <button type="button" class="add-resource-btn" data-action="adicionarRecurso">
                    <i class="fas fa-plus"></i> Adicionar Recurso
                </button>
            </div>

            <div class="resources-list">
                {{#each recursos}}
                <div class="resource-card" data-resource-id="{{this.id}}">
                    <div class="resource-header">
                        <span class="resource-name">{{this.nome}}</span>
                        <div class="resource-actions">
                            {{#if this.temRolagem}}
                            <button type="button" class="resource-roll-btn" data-action="rolarRecurso" data-resource-id="{{this.id}}" title="Rolar">
                                <i class="fas fa-dice"></i>
                            </button>
                            {{/if}}
                            <button type="button" class="resource-delete-btn" data-action="removerRecurso" data-resource-id="{{this.id}}" title="Remover">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    {{#if this.descricao}}
                    <div class="resource-description">{{this.descricao}}</div>
                    {{/if}}
                    {{#if this.temRolagem}}
                    <div class="resource-roll-info">
                        <span class="roll-formula">{{this.dadosRolagem}}</span>
                        {{#if this.atributoRolagem}}<span class="roll-attr">+ {{this.atributoRolagem}}</span>{{/if}}
                        {{#if this.periciaRolagem}}<span class="roll-skill">+ {{this.periciaRolagem}}</span>{{/if}}
                        {{#if this.modificador}}<span class="roll-mod">{{#if (gt this.modificador 0)}}+{{/if}}{{this.modificador}}</span>{{/if}}
                    </div>
                    {{/if}}
                </div>
                {{else}}
                <div class="empty-message">
                    <i class="fas fa-inbox"></i>
                    <p>Nenhum recurso adicionado.</p>
                </div>
                {{/each}}
            </div>
        </section>

        {{!-- Tab: Inventario --}}
        <section class="tab-content {{#if (eq activeTab 'inventario')}}active{{/if}}" data-tab="inventario">
            <div class="inventory-header">
                <h3 class="section-title">
                    <i class="fas fa-briefcase"></i> Inventario
                </h3>
                <button type="button" class="add-item-btn" data-action="adicionarItem">
                    <i class="fas fa-plus"></i> Adicionar Item
                </button>
            </div>

            <div class="inventory-list">
                {{#each inventario}}
                <div class="inventory-item" data-item-id="{{this.id}}">
                    <div class="item-info">
                        <span class="item-name">{{this.nome}}</span>
                        {{#if this.descricao}}
                        <span class="item-description">{{this.descricao}}</span>
                        {{/if}}
                    </div>
                    <div class="item-quantity">
                        <input type="number" name="system.inventario.{{@index}}.quantidade" value="{{this.quantidade}}" min="0" />
                    </div>
                    <button type="button" class="item-delete-btn" data-action="removerItem" data-item-id="{{this.id}}" title="Remover">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                {{else}}
                <div class="empty-message">
                    <i class="fas fa-box-open"></i>
                    <p>Nenhum item no inventario.</p>
                </div>
                {{/each}}
            </div>
        </section>
    </div>
</div>
