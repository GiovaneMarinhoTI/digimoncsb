<fieldset class="custom-system-fieldset">
    <legend>{{localize "CSB.ComponentProperties.ComponentType.MirrorComponent"}}</legend>

    <div class='custom-system-form-field'>
        <label for='mirrorComponentTargetKey-{{appId}}'>
            {{localize 'CSB.ComponentProperties.MirrorComponent.TargetKey'}}
            {{> icon-info title=(localize 'CSB.ComponentProperties.MirrorComponent.TargetKeyDescription')}}
        </label>
        <input id='mirrorComponentTargetKey-{{appId}}' type='text' data-key='targetKey' name='targetKey' value='{{targetKey}}' />
    </div>
</fieldset>